({
  name: 'difference',
  length: [20, 100],
  test: difference => {
    const result = difference([1, 2, 3, 4], [2, 4]);

    if (result.join() !== '1,3') {
      throw new Error('Difference test failed');
    }

    if (difference([], [1]).length !== 0) {
      throw new Error('Empty array test failed');
    }
  },
})
